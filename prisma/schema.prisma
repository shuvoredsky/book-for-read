generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccessStatus {
  ACTIVE
  REVOKED
}

model User {
  id            String       @id @default(cuid())
  name          String
  username      String       @unique
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          Role         @default(USER)
  status        UserStatus   @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Better Auth Relations
  sessions      Session[]
  accounts      Account[]

  // Application Relations
  payments          Payment[]
  bookAccesses      BookAccess[]
  readingProgresses ReadingProgress[]
  bookmarks         Bookmark[]
  deviceSessions    DeviceSession[]
  auditLogs         AuditLog[]

  @@index([username])
  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  price       Int      @default(100)
  r2ObjectKey String   // e.g. "books/medical-book.pdf"
  totalPages  Int      @default(240)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookAccesses      BookAccess[]
  readingProgresses ReadingProgress[]
  bookmarks         Bookmark[]

  @@index([slug])
  @@index([isActive])
  @@map("books")
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  amount        Int
  paymentMethod String        // "bKash" | "Nagad" | "Rocket"
  transactionId String        @unique
  senderNumber  String
  status        PaymentStatus @default(PENDING)
  submittedAt   DateTime      @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  adminNote     String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookAccess    BookAccess?

  @@index([userId])
  @@index([transactionId])
  @@index([status])
  @@index([submittedAt])
  @@map("payments")
}

model BookAccess {
  id        String       @id @default(cuid())
  userId    String
  bookId    String
  paymentId String?      @unique
  status    AccessStatus @default(ACTIVE)
  grantedAt DateTime     @default(now())
  revokedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  payment   Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([status])
  @@map("book_accesses")
}

model ReadingProgress {
  id                 String   @id @default(cuid())
  userId             String
  bookId             String
  currentPage        Int      @default(1)
  totalPages         Int      @default(1)
  progressPercentage Float    @default(0)
  lastReadAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book               Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("reading_progresses")
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  bookId     String
  pageNumber Int
  label      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, pageNumber])
  @@index([userId, bookId])
  @@map("bookmarks")
}

model DeviceSession {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String   // PAYMENT_APPROVED, PAYMENT_REJECTED, ACCESS_GRANTED, ACCESS_REVOKED, USER_SUSPENDED, USER_RESTORED, BOOK_UPDATED
  target    String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId])
  @@index([action])
  @@map("audit_logs")
}
